// Audigram — Phase 2 data model
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  bio           String?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  audios    Audio[]
  likes     Like[]
  comments  Comment[]

  // people this user follows
  following Follow[] @relation("FollowerRelation")
  // people who follow this user
  followers Follow[] @relation("FollowingRelation")
}

// --- Auth.js (NextAuth v5) required models for the database session strategy ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Audio {
  id          String   @id @default(cuid())
  title       String
  description String?
  genre       String?
  coverUrl    String
  audioUrl    String
  videoUrl    String?
  durationSec Int
  plays       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  creatorId   String
  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  likes       Like[]
  comments    Comment[]

  @@index([genre])
  @@index([createdAt])
  @@index([creatorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  audioId   String
  createdAt DateTime @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  audio     Audio @relation(fields: [audioId], references: [id], onDelete: Cascade)

  @@unique([userId, audioId]) // one like per user per audio
  @@index([audioId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  userId    String
  audioId   String
  createdAt DateTime @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  audio     Audio @relation(fields: [audioId], references: [id], onDelete: Cascade)

  @@index([audioId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("FollowerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("FollowingRelation", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // can't follow the same creator twice
  @@index([followingId])
}

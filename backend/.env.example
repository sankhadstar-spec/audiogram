# Postgres connection string — Neon, Supabase, or Railway all have a free tier
DATABASE_URL="postgresql://user:password@host:5432/audigram"

# Google OAuth — from console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI must be: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# File storage for published audio/video/cover (Cloudflare R2 recommended — no egress fees)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
